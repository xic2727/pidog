# ==============================================================================
# Pidog 智能伴侣环境变量配置文件 (.env)
# 复制此文件为 .env 并填入实际的 API Key
# ==============================================================================

# 小米 MiMo 平台统一配置 (ASR & TTS 共用)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 小米 ASR (语音识别) 配置
XIAOMI_ASR_MODEL=mimo-v2.5-asr

# 小米 TTS (语音合成) 音色与个性风格微调
# 可选预置音色：茉莉 (默认推荐女声)、冰糖 (温柔女声)、苏打 (阳光少年/男声)、白桦 (成熟男声)、Mia (英文女声)、Chloe (英文女声)、Milo (英文男声)
XIAOMI_TTS_MODEL=mimo-v2.5-tts
XIAOMI_TTS_VOICE=茉莉
# 自然语言导演提示词，精细控制发音语气、情绪、节奏与人设
XIAOMI_TTS_STYLE=活泼可爱的小狗语气，声音明亮、轻快、富有亲和力与陪伴感，语调微微上扬。

# MiniMax 大模型与多模态 VLM
# 推荐极速版: MiniMax-M2.7-highspeed (输出速度约 100 TPS)
# 也支持: MiniMax-M3, MiniMax-M2.7, MiniMax-M2.5-highspeed 等
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# 硬件音频输入设备 (ALSA 设备名，默认 plughw:1,0 对应树莓派语音帽/声卡 card 1)
# 运行 arecord -l 可以查看麦克风所在的 card 编号
AUDIO_INPUT_DEVICE=plughw:1,0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DOUBAO_API_KEY=

# 电量监控与低电量提醒配置 (可选)
# 锂电池电压参考：满电 ~8.4V，中等 ~7.4V，低电量 ~7.0V，临界断电 ~6.6V
BATTERY_CHECK_INTERVAL=15.0
BATTERY_LOW_VOLTAGE=7.0
BATTERY_CRITICAL_VOLTAGE=6.6
BATTERY_LOW_MSG=主人，我的电量有点低了，记得给我充电哦！
BATTERY_CRITICAL_MSG=主人，我快要没电啦，马上就要休息了，快帮我充电吧！

